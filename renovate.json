{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^np-complete//"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "np-complete/book-actions"
      ],
      "rangeStrategy": "replace",
      "minimumReleaseAge": "0 days",
      "automerge": true,
      "groupName": null
    }
  ]
}
